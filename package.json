	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.24.2",
		"eslint": "^9.39.5",
		"obsidian": "^1.8.7",
		"playwright-core": "^1.65.0",
		"tslib": "^2.9.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1"
	}
}
